{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Joan",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#typewords"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#identifier"
		},
		{
			"include": "#function_call"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#single_string"
		},
		{
			"include": "#template-string"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.joan",
				"match": "\\b(if|elseif|else|fn|class|struct|match|const|let|while|for|break|continue|is|and|or|as|not|using|loop|return)\\b"
			}]
		},
		"typewords": {
			"patterns": [
				{
					"name": "typewords.joan",
					"match": "\\b(None|true|false|println|then)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "operators.control.joan",
					"match": "[=+\\-\\*.<>@~$%^&!?:.\\\\#]+"
				}
			]
		},
		"function_call": {
			"patterns": [
				{
					"name": "function.call.joan",
					"match": "^([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\((.*)\\)$"
				}
			]
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.block.joan",
					"match": "//.*"
				}
			]
		},
		"identifier": {
			"patterns": [
				{
					"name": "ident.joan",
					"match": "[a-zA-Z0-9]"
				}
			]
		},
		"single_string": {
			"name": "string.quoted.single.joan",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.joan",
					"match": "\\\\."
				}
			]
		},
		"template-string": {
			"name": "string.quoted.temp_string.joan",
			"begin": "`",
			"end": "`",
			"patterns": [
				{
					"name": "constant.character.escape.joan",
					"match": "\\\\."
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.joan",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.joan",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.jx"
}