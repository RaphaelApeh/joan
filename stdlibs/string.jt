/*
    String Lib
*/

fn is_digit(c){
    return c >= '0' and c <= '9'
}

fn is_alpha(c){
    return c >= 'A' or c >= 'a' and c <= 'Z' or c <= 'Z'
}

fn is_upper(c){
    return c >= 'A' and c <= 'Z'
}

fn is_lower(c){
    return c >= 'a' and c <= 'z'
}

fn to_lower(c)
{
    return tochar(c + 32)
}

fn to_upper(c)
{
    return tochar(c - 32)
}


fn to_upper(c)
{
    return tochar(c - 32)
}

fn uppercase(str)
{
    s := str
    for i := 0; i < len(str); i += 1{
        if is_upper(s[i]) then continue
        s[i] = to_upper(s[i])
    }
    return s
}

fn lowercase(str)
{
    s := str
    for i := 0; i < len(str); i += 1{
        if not is_lower(s[i]) then
            s[i] = is_lower(s[i])
    }
    return s
}

fn capitalise(str)
{
    str[0] = to_upper(str[0])
    return;
}

fn contains(str, s)
{
    return s in str
}

fn find_index(str, s)
{
    count := len(str)
    index := -1
    for i := 0; i < count; i += 1{
        if (str[i] == s){
            index = i
            break
        }
    }
    return index
}

fn is_whitespace(c) {
    // TODO: new syntax -> '\n', '\r', '\t' => then ..
    match c {
        ' ' => then return true
        '\n' => then return true
        '\r' => then return true
        '\t' => then return true
        else then return false
    }
}


fn reverse(str)
{
    assert false, "Not yet implemented this function."
    chars := ""
    for i := len(str) - 1; i >= 0; i -= 1 {
        chars.push(str[i]) // TODO: string push function
    }
    return chars
}