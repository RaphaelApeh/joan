// functions
assert (false, "Not Yet Implement '~'");

fn next_multof(value, fac)
{
    assert(typeof(value) == INTEGER);
    assert(typeof(value) == typeof(fac));
    if (fac == 1) then
        return value;
    assert(fac % 2 == 0);
    return (value + fac - 1) & ~(fac - 1);
}

