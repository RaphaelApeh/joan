let hm = #{None}

const __IS_MAIN__ : bool = true

fn append_value(name, value)
{
    if (name is None) then 
        hm["None"] = value
    else
        hm[name] = value
    return 0
}
fn main()
{
    append_value("name", "John")
    append_value("age", 32)
    append_value(None, "name is None")
    printf("Values: %v", hm)
    return None
}

if __IS_MAIN__ then
    main()
else
    printf("unable to run main")