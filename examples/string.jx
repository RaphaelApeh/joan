printf("Args = %v, len = %d", argv, len(argv));
if (len(argv) <= 1) then
    exit(1);

if argv[1] == "hello"
{
    printf("Hello world\n");
}
elseif argv[1] == "world"
{
    printf("World World\n");
}

for i not in [1, 2, 3, 4] then
    printf("Hello world")

for i = 0; i < 10; i++ then
    printf("Hello world")