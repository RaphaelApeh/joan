__AUTHOR__ := "John Doe";

if __AUTHOR__ {
    printf("Hello, %s", __AUTHOR__);
} elseif !__AUTHOR__ {
    printf("NO Author");
} else {
    printf("Sorry..");
}


fn fib(num)
{
    assert(typeof(num) == INTEGER, "fib() expected an 'int'.");
    a := 0;
    b := 1;
    for ;a < num;{
        printf("%d", a);
        c := a + b;
        a = b;
        b = c;
    }
}
fib(1_000_000);